;; =============================================================================
;; init.el
;; =============================================================================

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; straight.el bootstrap
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(defvar bootstrap-version)
(let ((bootstrap-file
       (expand-file-name
        "straight/repos/straight.el/bootstrap.el"
        (or (bound-and-true-p straight-base-dir)
            user-emacs-directory)))
      (bootstrap-version 7))
  (unless (file-exists-p bootstrap-file)
    (with-current-buffer
        (url-retrieve-synchronously
         "https://raw.githubusercontent.com/radian-software/straight.el/develop/install.el"
         'silent 'inhibit-cookies)
      (goto-char (point-max))
      (eval-print-last-sexp)))
  (load bootstrap-file nil 'nomessage))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Basic settings
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(setq package-enable-at-startup nil)
(setq make-backup-files nil)
(setq auto-save-default nil)
(setq truncate-lines t)
(setq truncate-partial-width-windows t)
(setq-default indent-tabs-mode nil)
(setq-default tab-width 2)
(setq scroll-conservatively 1)
(setq scroll-margin 10)
(setq next-screen-context-lines 5)
(setq scroll-preserve-screen-position t)
(setq windmove-wrap-around t)
(setq ruby-insert-encoding-magic-comment nil)
(setq custom-file "~/.emacs.d/custom.el")
(condition-case nil
    (load custom-file)
  (error nil))

(straight-use-package 'use-package)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Language packages
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(use-package markdown-mode
  :straight t
  :mode (("\\.md\\'" . markdown-mode)
         ("\\.markdown\\'" . markdown-mode))
  :init
  ;; pandoc があれば HTML 変換に使う（後述の markdown-preview と連携）
  (setq markdown-command "pandoc --from=markdown --to=html5 --standalone"))

(use-package dotenv-mode
  :straight t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Completion
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(use-package company
  :straight t
  :init (global-company-mode)
  :config
  (setq company-idle-delay 0.2
        company-minimum-prefix-length 1
        company-show-numbers t))

(use-package company-web
  :straight t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Docker
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(use-package dockerfile-mode
  :straight t)
(use-package docker-compose-mode
  :straight t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Ruby
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(use-package ruby-end
  :straight t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Go
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(use-package go-mode
  :straight t
  :hook (go-mode . (lambda ()
                     (setq tab-width 4)
                     (setq indent-tabs-mode t))))
(use-package company-go
  :straight t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; TypeScript / TSX
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(use-package typescript-ts-mode
  :straight t
  :mode (("\\.ts\\'" . tsx-ts-mode)
         ("\\.tsx\\'" . tsx-ts-mode))
  :config
  (setq typescript-ts-mode-indent-offset 2))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Tree-sitter
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(use-package treesit
  :config
  (setq treesit-font-lock-level 4))

(use-package treesit-auto
  :straight t
  :init
  (require 'treesit-auto)
  (global-treesit-auto-mode)
  :config
  (setq treesit-auto-install t))

(use-package tree-sitter
  :straight t
  :hook ((typescript-ts-mode . tree-sitter-hl-mode)
         (tsx-ts-mode        . tree-sitter-hl-mode))
  :config
  (global-tree-sitter-mode))

(use-package tree-sitter-langs
  :straight t
  :after tree-sitter
  :config
  (tree-sitter-require 'tsx)
  (add-to-list 'tree-sitter-major-mode-language-alist '(tsx-ts-mode . tsx)))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Developer support
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(use-package magit
  :straight t
  :bind ("C-x g" . magit-status))

(use-package editorconfig
  :straight t
  :init (editorconfig-mode 1))

(use-package rainbow-delimiters
  :straight t
  :hook (prog-mode . rainbow-delimiters-mode))

(use-package dumb-jump
  :straight t
  :init (dumb-jump-mode))

(use-package web-mode
  :straight t)

(use-package neotree
  :straight t
  :config
  (setq neo-smart-open t)
  (setq-default neo-show-hidden-files t))

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Markdown + Mermaid preview  (ターミナル Emacs 対応)
;;
;; 戦略:
;;   ターミナルでは画像を直接描画できないため、
;;   eww (Emacs 内蔵ブラウザ) か xdg-open/open でブラウザに渡す 2 段構えにする。
;;   Mermaid は pandoc-lua-filter または mermaid-filter (npm) で SVG に変換してから埋め込む。
;;
;; 事前準備:
;;   1. pandoc のインストール: brew install pandoc / apt install pandoc
;;   2. Mermaid フィルタ:      npm install -g mermaid-filter
;;      または                 pip install pandoc-mermaid-filter
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(use-package markdown-mode
  ;; 上の markdown-mode と統合 ― :config だけ追加する形で定義
  :straight t
  :config
  (defun my/markdown-preview-browser ()
    "現在の Markdown バッファを pandoc で HTML に変換しブラウザで開く。
     Mermaid コードブロックは mermaid-filter で SVG に変換される。"
    (interactive)
    (let* ((src  (buffer-file-name))
           (out  (make-temp-file "emacs-md-preview" nil ".html"))
           ;; mermaid-filter が PATH にある場合は自動で有効化
           (filter-flag
            (if (executable-find "mermaid-filter")
                "--filter mermaid-filter"
              ""))
           (cmd (format "pandoc %s --from=gfm %s --to=html5 --standalone --metadata title=Preview -o %s"
                        (shell-quote-argument src)
                        filter-flag
                        (shell-quote-argument out))))
      (if (not src)
          (message "ファイルを保存してから実行してください")
        (progn
          (shell-command cmd)
          ;; GUI があれば xdg-open、なければ eww で開く
          (if (display-graphic-p)
              (browse-url (concat "file://" out))
            (eww-open-file out))
          (message "Preview: %s" out)))))

  (defun my/markdown-preview-eww ()
    "Mermaid なし・高速プレビュー用。eww で即時表示する。"
    (interactive)
    (let* ((src (buffer-file-name))
           (out (make-temp-file "emacs-md-eww" nil ".html"))
           (cmd (format "pandoc %s --from=gfm --to=html5 --standalone -o %s"
                        (shell-quote-argument src)
                        (shell-quote-argument out))))
      (if (not src)
          (message "ファイルを保存してから実行してください")
        (progn
          (shell-command cmd)
          (eww-open-file out)))))

  :bind (:map markdown-mode-map
              ("C-c C-p"   . my/markdown-preview-browser) ; Mermaid 込みブラウザ
              ("C-c C-e"   . my/markdown-preview-eww)))   ; eww 内即時プレビュー

;; markdown-toc: 目次を自動生成 (C-c C-o)
(use-package markdown-toc
  :straight t)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; AI 伴走 1: gptel  ― Claude との対話チャット & コード相談
;;
;; 使い方:
;;   M-x gptel          → チャットバッファを開く
;;   M-x gptel-send     → 選択リージョン or バッファをプロンプトとして送信
;;   C-c RET            → gptel-send のデフォルトキーバインド
;;
;; セットアップ:
;;   (setq my/anthropic-api-key "sk-ant-...")
;;   または環境変数 ANTHROPIC_API_KEY を設定する
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(use-package gptel
  :straight t
  :config
  (setq gptel-default-mode 'markdown-mode)

  ;; Claude バックエンドの登録
  (setq gptel-backend
        (gptel-make-anthropic
         "Claude"
         :stream t
         :key (lambda ()
                (or (getenv "ANTHROPIC_API_KEY")
                    (error "ANTHROPIC_API_KEY が設定されていません")))))

  ;; 使用モデル (claude-sonnet-4-20250514 推奨; 必要に応じて変更)
  (setq gptel-model 'claude-sonnet-4-20250514)

  ;; システムプロンプト: コードレビュー・Go/TypeScript に特化させる
  (setq gptel-system-prompt
        "あなたは優秀なソフトウェアエンジニアです。
Go (Gin / DDD / Layered Architecture) と TypeScript (Next.js) を主軸とした
バックエンド・フロントエンド開発を支援してください。
コードレビュー、リファクタリング提案、設計相談に積極的に答えてください。
回答は日本語でお願いします。")

  ;; gptel バッファの見た目を整える
  (add-hook 'gptel-mode-hook
            (lambda ()
              (visual-line-mode 1)
              (display-line-numbers-mode -1)))

  :bind (("C-c a c" . gptel)             ; チャットバッファを開く
         ("C-c a s" . gptel-send)        ; 送信
         ("C-c a r" . gptel-rewrite)     ; 選択範囲をリライト
         ("C-c a m" . gptel-menu)))      ; メニュー (モデル/パラメータ変更)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; AI 伴走 2: copilot.el  ― インライン補完
;;
;; 使い方:
;;   補完候補が出たら Tab で受け入れ、M-n / M-p で候補を切り替え。
;;   C-c a i でトグル (一時的にオフにしたいとき)
;;
;; セットアップ:
;;   初回: M-x copilot-login  → ブラウザでデバイス認証
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(use-package copilot
  :straight (:host github :repo "copilot-emacs/copilot.el" :branch "main")
  :hook ((prog-mode      . copilot-mode)
         (markdown-mode  . copilot-mode))
  :config
  (setq copilot-indent-offset-warning-disable t)
  :bind (:map copilot-completion-map
              ("<tab>"   . copilot-accept-completion)
              ("TAB"     . copilot-accept-completion)
              ("M-n"     . copilot-next-completion)
              ("M-p"     . copilot-previous-completion)
              ("M-<tab>" . copilot-accept-completion-by-word)))

(defun my/copilot-toggle ()
  "copilot-mode をトグルする。"
  (interactive)
  (if copilot-mode
      (progn (copilot-mode -1) (message "Copilot: OFF"))
    (progn (copilot-mode  1) (message "Copilot: ON"))))

(global-set-key (kbd "C-c a i") 'my/copilot-toggle)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Window movement
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(windmove-default-keybindings)
(global-set-key (kbd "<ESC> <left>")  'windmove-left)
(global-set-key (kbd "S-<left>")      'windmove-left)
(global-set-key (kbd "<ESC> <down>")  'windmove-down)
(global-set-key (kbd "S-<down>")      'windmove-down)
(global-set-key (kbd "<ESC> <right>") 'windmove-right)
(global-set-key (kbd "S-<right>")     'windmove-right)
(global-set-key (kbd "<ESC> <up>")    'windmove-up)
(global-set-key (kbd "S-<up>")        'windmove-up)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; org-mode
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
(global-set-key "\C-cl" 'org-store-link)
(global-set-key "\C-cc" 'org-capture)
(global-set-key "\C-ca" 'org-agenda)
(global-set-key "\C-cb" 'org-iswitchb)

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
